{
  "name": "mathmaster-thcs",
  "version": "2.0.0",
  "private": true,
  "description": "Nền tảng Luyện thi & Học Toán THCS (Lớp 6, 7, 8, 9) - Full-stack Next.js 14 + Prisma 5 + PostgreSQL",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "test": "tsx scripts/test-flows.mjs",
    "test:admin": "tsx scripts/test-admin-students.mjs",
    "create-admin": "tsx scripts/create-admin.mjs",
    "test:email-verification": "tsx scripts/test-email-verification.mjs",
    "test:forgot-password": "tsx scripts/test-forgot-password.mjs",
    "test:engine": "tsx scripts/test-question-engine.mjs",
    "bank:audit": "tsx scripts/bank-audit.mjs",
    "audit:difficulty": "tsx scripts/audit-difficulty.mjs",
    "test:documents": "tsx scripts/test-documents.mjs",
    "test:ai": "tsx scripts/test-ai-features.mjs",
    "dev:lan": "node scripts/start-lan.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@prisma/client": "5.22.0",
    "@types/katex": "^0.16.8",
    "@vercel/blob": "^2.8.2",
    "chart.js": "^4.5.1",
    "jose": "^6.2.13",
    "katex": "^0.19.0",
    "mammoth": "^1.13.0",
    "mathjs": "^15.2.0",
    "next": "14.2.15",
    "nodemailer": "^10.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "unpdf": "^1.9.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tsx": "^4.23.15",
    "typescript": "5.6.3"
  }
}
