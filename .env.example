# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG MATHMASTER THCS (.env.example)
# Hướng dẫn: Sao chép file này thành file tên là ".env" ở cùng thư mục gốc dự án.
# Trên Windows PowerShell, chạy lệnh: copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# PHẦN 1: CÁC BIẾN BẮT BUỘC ([BẮT BUỘC] - Cần có để chạy Backend & Database)
# ------------------------------------------------------------------------------

# 1. [BẮT BUỘC] Chuỗi kết nối Cơ sở dữ liệu PostgreSQL (DATABASE_URL)
# - Khuyến nghị cho người mới: Dùng PostgreSQL miễn phí trên mây của Neon.tech hoặc Supabase.com
#   (Không cần tự cài đặt PostgreSQL Server nặng máy trên Windows).
# - Ví dụ với Neon.tech:
#   DATABASE_URL="postgresql://neondb_owner:mat_khau@ep-cool-math-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# - Ví dụ nếu bạn cài PostgreSQL trực tiếp trên máy tính Windows (cổng 5432):
DATABASE_URL="postgresql://postgres:123456@localhost:5432/mathmaster_thcs?schema=public"

# 2. [BẮT BUỘC] Khóa bí mật dùng để ký Token đăng nhập JWT & Cookie phiên làm việc (AUTH_SECRET)
# - Ở môi trường máy cá nhân (localhost), bạn có thể giữ nguyên chuỗi mặc định bên dưới.
# - Khi đưa lên mạng (Production), hãy đổi thành một chuỗi ngẫu nhiên dài ít nhất 32 ký tự.
AUTH_SECRET="mathmaster-thcs-secret-key-2026-local-development-safe-token"

# 3. [BẮT BUỘC] Địa chỉ chạy ứng dụng Web (NEXT_PUBLIC_APP_URL)
# - Mặc định khi chạy trên máy tính cá nhân là http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. [BẮT BUỘC] Chế độ lưu trữ file tài liệu tải lên (UPLOAD_STORAGE_DRIVER)
# - Giá trị mặc định "local": Lưu file trực tiếp vào thư mục "public/uploads" ngay trong dự án.
#   Đây là phương án dễ nhất cho người mới, không cần đăng ký AWS S3.
# - Có thể đổi thành "supabase" nếu muốn lưu lên Supabase Storage.
UPLOAD_STORAGE_DRIVER="local"

# 5. [BẮT BUỘC] Giới hạn dung lượng tối đa của mỗi file tải lên (tính bằng MB)
MAX_UPLOAD_SIZE_MB="15"


# ------------------------------------------------------------------------------
# PHẦN 2: CÁC BIẾN TÙY CHỌN ([TÙY CHỌN] - Không bắt buộc, để trống web vẫn chạy)
# ------------------------------------------------------------------------------
# LƯU Ý QUAN TRỌNG:
# - Nếu bạn ĐỂ TRỐNG các biến AI/OCR bên dưới, toàn bộ các chức năng cốt lõi của web
#   (Tạo đề theo ma trận, Làm bài, Chấm điểm Toán tương đương, Lưu lịch sử, Khôi phục bài thi,
#   Đọc và tách câu hỏi từ file văn bản .TXT / .MD / .CSV, Xem lời giải 3 bước từ ngân hàng)
#   VẪN HOẠT ĐỘNG 100% BÌNH THƯỜNG.
# - Những chức năng thực sự cần AI (như OCR đọc chữ từ file ảnh chụp/PDF scan hoặc hỏi đáp AI tự do)
#   sẽ hiển thị thông báo rõ ràng rằng chưa có API Key, tuyệt đối KHÔNG giả lập thành công.

# 6. [TÙY CHỌN] Khóa API Google Gemini (GEMINI_API_KEY)
# - Dùng để bật tính năng hỏi đáp AI mở rộng và trích xuất câu hỏi từ file PDF/Ảnh chụp.
# - Lấy khóa miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 7. [TÙY CHỌN] Khóa API Mathpix OCR (MATHPIX_APP_ID và MATHPIX_APP_KEY)
# - Dùng để nhận diện công thức Toán LaTeX chuyên sâu từ ảnh chụp đề thi.
MATHPIX_APP_ID=""
MATHPIX_APP_KEY=""

# 8. [TÙY CHỌN] Cấu hình Supabase Storage (Chỉ điền khi đặt UPLOAD_STORAGE_DRIVER="supabase")
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="mathmaster-documents"
