// ==============================================================================
// MathMaster THCS - Prisma Schema hoàn chỉnh (PostgreSQL)
// Đã kiểm tra tính tương thích với Prisma 5.22.0 & PostgreSQL 15/16
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum CognitiveLevel {
  NHAN_BIET
  THONG_HIEU
  VAN_DUNG
  VAN_DUNG_CAO
}

enum QuestionType {
  MCQ
  ESSAY
}

enum VerificationStatus {
  DRAFT
  VERIFIED
  PENDING_REVIEW
  REJECTED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  VERIFIED
  FAILED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum MasteryLevel {
  INSUFFICIENT_DATA
  NEEDS_WORK
  PROGRESSING
  MASTERED
}

model users {
  id                    String                  @id @default(uuid())
  email                 String                  @unique
  username              String                  @unique
  password_hash         String
  role                  Role                    @default(STUDENT)
  is_guest              Boolean                 @default(false)
  must_change_password  Boolean                 @default(false)
  password_updated_at   DateTime?
  failed_login_count    Int                     @default(0)
  locked_until          DateTime?
  anonymous_leaderboard Boolean                 @default(false)
  favorite_question_ids String[]                @default([])
  onboarding_completed  Boolean                 @default(false)
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  profile               user_profiles?
  settings              user_settings?
  sessions              sessions[]
  password_reset_tokens password_reset_tokens[]
  source_documents      source_documents[]
  generated_exams       generated_exams[]
  exam_attempts         exam_attempts[]
  topic_mastery         topic_mastery[]
  review_queue          review_queue[]
  study_sessions        study_sessions[]
  user_achievements     user_achievements[]
  learning_goals        learning_goals[]
  taught_classrooms     classrooms[]            @relation("TeacherClassrooms")
  classroom_memberships classroom_members[]
}

model sessions {
  id             String    @id @default(uuid())
  user_id        String
  device_name    String    @default("Trình duyệt Web")
  user_agent     String?
  ip_address     String?
  remember_me    Boolean   @default(false)
  created_at     DateTime  @default(now())
  last_active_at DateTime  @default(now())
  expires_at     DateTime
  revoked_at     DateTime?
  user           users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, revoked_at, expires_at])
}

model password_reset_tokens {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, used_at, expires_at])
}

model user_profiles {
  id                String    @id @default(uuid())
  user_id           String    @unique
  full_name         String
  current_grade     Int       @default(8)
  preferred_book_id String    @default("KNTT")
  school_name       String?
  xp_points         Int       @default(0)
  level             Int       @default(1)
  streak_days       Int       @default(0)
  last_study_date   DateTime?
  user              users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user_settings {
  id                 String @id @default(uuid())
  user_id            String @unique
  theme              String @default("light")
  auto_save_interval Int    @default(10)
  daily_goal_minutes Int    @default(30)
  weekly_exam_target Int    @default(3)
  user               users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model textbooks {
  id        String            @id
  code      String            @unique
  name      String
  publisher String
  chapters  chapters[]
  questions questions[]
  exams     generated_exams[]
}

model grades {
  id         Int               @id
  name       String
  tagline    String?
  semesters  semesters[]
  chapters   chapters[]
  questions  questions[]
  exams      generated_exams[]
  formulas   math_formulas[]
  classrooms classrooms[]
}

model semesters {
  id       String     @id
  grade_id Int
  number   Int
  name     String
  grade    grades     @relation(fields: [grade_id], references: [id], onDelete: Cascade)
  chapters chapters[]

  @@unique([grade_id, number])
}

model chapters {
  id          String          @id
  textbook_id String
  grade_id    Int
  semester_id String
  order_index Int
  title       String
  book_notes  Json?
  lessons     String[]
  textbook    textbooks       @relation(fields: [textbook_id], references: [id])
  grade       grades          @relation(fields: [grade_id], references: [id])
  semester    semesters       @relation(fields: [semester_id], references: [id])
  topics      topics[]
  questions   questions[]
  formulas    math_formulas[]
}

model topics {
  id            String          @id
  chapter_id    String
  lesson_title  String
  topic_name    String
  problem_types String[]
  chapter       chapters        @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  questions     questions[]
  topic_mastery topic_mastery[]
}

model source_documents {
  id                        String         @id @default(uuid())
  user_id                   String
  file_name                 String
  file_type                 String
  file_size_bytes           Int
  storage_path              String
  extracted_text            String?
  extracted_questions_count Int            @default(0)
  grade_id                  Int
  textbook_id               String
  semester_number           Int
  chapter_id                String?
  processing_status         DocumentStatus @default(UPLOADED)
  is_seed_data              Boolean        @default(false)
  created_at                DateTime       @default(now())
  user                      users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  questions                 questions[]
}

model questions {
  id                   String              @id
  code                 String              @unique
  grade_id             Int
  textbook_id          String
  textbooks            String[]            @default(["KNTT", "CD", "CTST"])
  semester_number      Int
  chapter_id           String
  topic_id             String
  lesson_title         String?
  problem_type         String
  question_type        QuestionType
  difficulty           Difficulty
  cognitive_level      CognitiveLevel
  content              String
  default_points       Float               @default(1.0)
  source_doc_id        String?
  source_label         String?
  verification_status  VerificationStatus  @default(VERIFIED)
  empirical_difficulty Float?
  attempt_count        Int                 @default(0)
  correct_count        Int                 @default(0)
  template_id          String?
  version              Int                 @default(1)
  is_seed_data         Boolean             @default(false)
  created_at           DateTime            @default(now())
  grade                grades              @relation(fields: [grade_id], references: [id])
  textbook             textbooks           @relation(fields: [textbook_id], references: [id])
  chapter              chapters            @relation(fields: [chapter_id], references: [id])
  topic                topics              @relation(fields: [topic_id], references: [id])
  source_doc           source_documents?   @relation(fields: [source_doc_id], references: [id], onDelete: SetNull)
  options              question_options[]
  solution             question_solutions?
  exam_questions       exam_questions[]
  student_answers      student_answers[]
  review_items         review_queue[]

  @@index([grade_id, verification_status, cognitive_level, semester_number])
  @@index([chapter_id, verification_status, difficulty])
}

model question_options {
  id          String    @id @default(uuid())
  question_id String
  label       String
  content     String
  is_correct  Boolean   @default(false)
  question    questions @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([question_id, label])
}

model question_solutions {
  id                 String    @id @default(uuid())
  question_id        String    @unique
  standard_answer    String
  accepted_answers   String[]
  solution_text      String
  step_by_step_guide Json
  key_formula        String?
  common_mistakes    String?
  question           questions @relation(fields: [question_id], references: [id], onDelete: Cascade)
}

model math_formulas {
  id                  String    @id
  grade_id            Int
  semester_number     Int
  chapter_id          String
  title               String
  formula_latex       String
  condition_text      String?
  example_text        String?
  related_question_id String?
  grade               grades    @relation(fields: [grade_id], references: [id], onDelete: Cascade)
  chapter             chapters  @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
}

model generated_exams {
  id               String                  @id @default(uuid())
  user_id          String
  title            String
  exam_code        String                  @default("101")
  grade_id         Int
  textbook_id      String
  semester_number  Int
  exam_category    String
  difficulty       Difficulty
  format_type      String
  duration_minutes Int
  max_score        Float                   @default(10.0)
  seed             Int?
  chapter_ids      String[]                @default([])
  matrix_config    Json?
  composition      Json?
  is_favorite      Boolean                 @default(false)
  is_seed_data     Boolean                 @default(false)
  created_at       DateTime                @default(now())
  user             users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  grade            grades                  @relation(fields: [grade_id], references: [id])
  textbook         textbooks               @relation(fields: [textbook_id], references: [id])
  exam_questions   exam_questions[]
  exam_attempts    exam_attempts[]
  assignments      classroom_assignments[]

  @@index([user_id, created_at])
  @@index([grade_id, is_seed_data])
}

model exam_questions {
  id          String          @id @default(uuid())
  exam_id     String
  question_id String
  order_index Int
  points      Float
  exam        generated_exams @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  question    questions       @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([exam_id, question_id])
}

model exam_attempts {
  id                 String            @id @default(uuid())
  exam_id            String
  user_id            String
  grade_id           Int               @default(8)
  status             AttemptStatus     @default(IN_PROGRESS)
  started_at         DateTime          @default(now())
  submitted_at       DateTime?
  time_spent_seconds Int               @default(0)
  remaining_seconds  Int
  total_score        Float?
  mcq_score          Float?
  essay_score        Float?
  correct_count      Int               @default(0)
  wrong_count        Int               @default(0)
  unanswered_count   Int               @default(0)
  exam               generated_exams   @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  user               users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  student_answers    student_answers[]
  grading_result     grading_results?

  @@index([user_id, status, started_at])
  @@index([exam_id, user_id])
}

model student_answers {
  id                 String        @id @default(uuid())
  attempt_id         String
  question_id        String
  selected_option    String?
  essay_response     String?
  workings_text      String?
  flagged_for_review Boolean       @default(false)
  is_correct         Boolean?
  earned_points      Float         @default(0)
  error_category     String?
  matched_reason     String?
  ai_estimated       Boolean       @default(false)
  attempt            exam_attempts @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question           questions     @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([attempt_id, question_id])
  @@index([question_id, is_correct])
}

model grading_results {
  id                  String        @id @default(uuid())
  attempt_id          String        @unique
  total_score         Float
  mcq_score           Float
  essay_score         Float
  accuracy_percent    Float
  weak_topics_summary String[]
  graded_at           DateTime      @default(now())
  attempt             exam_attempts @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
}

model topic_mastery {
  id               String       @id @default(uuid())
  user_id          String
  grade_id         Int
  topic_id         String
  questions_done   Int          @default(0)
  questions_right  Int          @default(0)
  accuracy_percent Float        @default(0)
  mastery_level    MasteryLevel @default(INSUFFICIENT_DATA)
  user             users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  topic            topics       @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([user_id, topic_id])
}

model review_queue {
  id               String    @id @default(uuid())
  user_id          String
  question_id      String
  wrong_attempts   Int       @default(1)
  last_wrong_ans   String?
  error_type       String?
  resolved         Boolean   @default(false)
  ease_factor      Float     @default(2.5)
  interval_days    Int       @default(1)
  repetitions      Int       @default(0)
  next_review_at   DateTime  @default(now())
  last_reviewed_at DateTime?
  added_at         DateTime  @default(now())
  user             users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question         questions @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id])
  @@index([user_id, resolved, next_review_at])
}

model study_sessions {
  id               String   @id @default(uuid())
  user_id          String
  grade_id         Int
  activity_type    String
  duration_minutes Int
  xp_earned        Int      @default(0)
  session_date     DateTime @default(now())
  user             users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model achievements {
  id                String              @id
  code              String              @unique
  title             String
  description       String
  icon              String              @default("award")
  condition_text    String?
  xp_reward         Int
  user_achievements user_achievements[]
}

model user_achievements {
  id             String       @id @default(uuid())
  user_id        String
  achievement_id String
  unlocked_at    DateTime     @default(now())
  user           users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement    achievements @relation(fields: [achievement_id], references: [id], onDelete: Cascade)

  @@unique([user_id, achievement_id])
}

model learning_goals {
  id            String   @id @default(uuid())
  user_id       String
  title         String
  goal_type     String
  target_value  Int
  current_value Int      @default(0)
  unit          String   @default("đề")
  completed     Boolean  @default(false)
  user          users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model classrooms {
  id          String                  @id @default(uuid())
  teacher_id  String
  name        String
  grade_id    Int
  join_code   String                  @unique
  description String?
  created_at  DateTime                @default(now())
  teacher     users                   @relation("TeacherClassrooms", fields: [teacher_id], references: [id], onDelete: Cascade)
  grade       grades                  @relation(fields: [grade_id], references: [id])
  members     classroom_members[]
  assignments classroom_assignments[]
}

model classroom_members {
  id           String     @id @default(uuid())
  classroom_id String
  student_id   String
  joined_at    DateTime   @default(now())
  classroom    classrooms @relation(fields: [classroom_id], references: [id], onDelete: Cascade)
  student      users      @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([classroom_id, student_id])
}

model classroom_assignments {
  id           String          @id @default(uuid())
  classroom_id String
  exam_id      String
  title        String
  due_date     DateTime?
  created_at   DateTime        @default(now())
  classroom    classrooms      @relation(fields: [classroom_id], references: [id], onDelete: Cascade)
  exam         generated_exams @relation(fields: [exam_id], references: [id], onDelete: Cascade)
}

// ==============================================================================
// Bước 2.6 — Lưu trữ tách dữ liệu biến động khỏi JSONB mm_cloud_state
// Mỗi bảng có cột khoá đã đánh chỉ mục + cột data JSONB giữ nguyên toàn bộ bản ghi.
// Không có khoá ngoại sang users/exams vì 2 tập này vẫn nằm trong JSONB mm_cloud_state.
// ==============================================================================

model mm_cloud_state {
  id         String   @id
  payload    Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model mm_state_meta {
  id           String    @id
  migrated_at  DateTime? @db.Timestamptz(6)
  rows_version BigInt    @default(0)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
}

model mm_state_backups {
  id         BigInt   @id @default(autoincrement())
  reason     String
  payload    Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model mm_user_sessions {
  id         String    @id
  user_id    String
  expires_at DateTime? @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  ord        Float     @default(0)
  data       Json
  updated_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, revoked_at, expires_at])
}

model mm_exam_attempts {
  id         String   @id
  user_id    String
  exam_id    String?
  status     String?
  ord        Float    @default(0)
  data       Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, status])
  @@index([exam_id])
}

model mm_topic_mastery {
  id         String   @id
  user_id    String
  ord        Float    @default(0)
  data       Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id])
}

model mm_review_items {
  id             String    @id
  user_id        String
  question_id    String?
  resolved       Boolean   @default(false)
  next_review_at DateTime? @db.Timestamptz(6)
  ord            Float     @default(0)
  data           Json
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, resolved, next_review_at])
}
